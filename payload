# Replace with your actual domain and group name
$GroupName = "YourADGroupName"
$Searcher = [adsisearcher]"(sAMAccountName=$GroupName)"
$Group = $Searcher.FindOne()

if ($Group) {
    $GroupEntry = $Group.GetDirectoryEntry()
    # Loop through and display the distinguished name of each member
    foreach ($Member in $GroupEntry.member) {
        $Member
    }
} else {
    Write-Host "Group not found." -ForegroundColor Red
}
