$RootDSE = [ADSI]"LDAP://RootDSE"
$ConfigPath = $RootDSE.configurationNamingContext
$Searcher = New-Object System.DirectoryServices.DirectorySearcher
$Searcher.SearchRoot = [ADSI]"LDAP://$ConfigPath"
$Searcher.Filter = "(&(objectClass=serviceConnectionPoint)(name=*RightsManagementServices*))"
$Searcher.FindAll() | ForEach-Object { $_.Path }
